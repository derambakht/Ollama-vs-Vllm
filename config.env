# ---- Ollama vs vLLM benchmark: one place for every knob -----------------------------
# Source this on the GPU server:  source config.env

# Model (MUST be the same weights on both engines; 16-bit on both)
MODEL_HF="Qwen/Qwen3-8B"            # vLLM pulls this from Hugging Face
MODEL_HF_AWQ="Qwen/Qwen3-8B-AWQ"    # for the AWQ experiment
OLLAMA_TAG="qwen3:8b-fp16"          # NOT the default 4-bit tag
SERVED_NAME="qwen3-8b"              # what vLLM calls the model in /v1

# vLLM
VLLM_PIP="vllm==0.33.0"                 # native install, the version behind the published numbers
VLLM_NATIVE=0                           # 1 = run `vllm serve` directly (RunPod / any pod without a Docker daemon);
                                        # with 0, Docker is used if it exists, otherwise native
VLLM_IMAGE="vllm/vllm-openai:v0.33.0"   # Docker path only (not used for the published numbers). Pin it; 'latest' is not reproducible.
MAX_MODEL_LEN=8192
GPU_UTIL=0.85
MAX_NUM_SEQS=64
HF_HOME="/data/hf"                  # >= 60 GB free (8B BF16 + AWQ + tokenizer + compile cache)

# Ollama
OLLAMA_PORT=11434
OLLAMA_CTX=8192                     # tuned config only; matches MAX_MODEL_LEN
OLLAMA_PARALLEL=16                  # tuned config only

# Benchmark traffic
BENCH_HOST="127.0.0.1"              # set to the GPU server IP if loadgen runs on another machine
BATCH_LEVELS="1,4,8,16,32"
BATCH_RUNS=3
USER_LEVELS="4,8,16,32"
USER_DURATION=120                   # seconds per level
USER_THINK=3                        # mean seconds between a user's requests
RATE_LEVELS="0.5,1,2,4,8"
RATE_DURATION=60
RATE_TIMEOUT=120                    # rate mode: a request that receives no data for this many seconds is dropped
MAX_TOKENS=256
NO_THINK="template"                 # Qwen3 thinking switch. template = each engine's own switch (Ollama: reasoning_effort=none,
                                    # vLLM: enable_thinking=false) | soft = /no_think in the prompt (ignored by Ollama 0.40) | none
PROMPT_MIX="realistic"              # 'fixed' = one ~500-token prompt (runbook rule); 'realistic' = short/medium/long mix

# Where results go (relative to repo root)
RESULTS_DIR="results"
PY="${PY:-python3}"                 # or the venv python
